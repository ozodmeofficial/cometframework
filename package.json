{
  "name": "comet-framework",
  "version": "0.1.0",
  "description": "The build-free web framework. One script tag: reactivity, SPA router, HTTP-in-HTML, components, local ORM, mock API, i18n.",
  "main": "dist/comet.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node scripts/serve.mjs site 5173",
    "test": "node scripts/build.mjs && node --test tests/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ozodmeofficial/cometframework.git"
  },
  "keywords": [
    "framework",
    "reactive",
    "spa",
    "router",
    "no-build",
    "htmx",
    "alpine",
    "web-components",
    "orm",
    "indexeddb"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ozodmeofficial/cometframework/issues"
  },
  "homepage": "https://ozodmeofficial.github.io/cometframework/",
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright": "^1.63.0"
  },
  "unpkg": "dist/comet.min.js",
  "jsdelivr": "dist/comet.min.js",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ]
}
